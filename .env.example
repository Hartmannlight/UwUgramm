# Copy to .env. Generate independent values with: openssl rand -hex 32
# Use hex for POSTGRES_PASSWORD so it is also safe inside DATABASE_URL.
POSTGRES_PASSWORD=replace-with-64-random-hex-characters
SECRET_KEY=replace-with-an-independent-random-secret-at-least-32-characters
IDENTITY_KEY=replace-with-another-independent-random-secret-at-least-32-characters
ENVIRONMENT=production
APP_ORIGIN=https://diagram.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
