{
  "name": "uwugramm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:static": "node scripts/prepare-static.mjs && tsc -b && vite build --mode static",
    "test:static": "playwright test --config playwright.static.config.ts",
    "test": "vitest run src",
    "format": "prettier --write src vite.config.ts scripts e2e playwright.static.config.ts",
    "format:check": "prettier --check src vite.config.ts scripts e2e playwright.static.config.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.2",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@uiw/react-codemirror": "^4.23.7",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "24.19.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "pyodide": "314.0.7",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  }
}
